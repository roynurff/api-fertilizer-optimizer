# ── Environment Variables ──────────────────────────────────────────────────────
# Copy file ini menjadi .env dan sesuaikan dengan environment kamu.

APP_NAME="Fertilizer Route Optimizer"
DEBUG=false

# CORS — ganti ke URL Laravel production kamu
# Format: ["http://localhost:8000","https://yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000"]

# ALNS Default Parameters (bisa di-override via request body)
DEFAULT_ITERASI=158
DEFAULT_KAPASITAS_TRUK=250
DEFAULT_BATAS_WAKTU=240.0
DEFAULT_WAKTU_JALAN=2.0
DEFAULT_WAKTU_BONGKAR=0.5
DEFAULT_W_TOLERANSI=0.05
DEFAULT_ALPHA=0.95
DEFAULT_RHO=0.1
DEFAULT_DESTROY_RATIO=0.30
